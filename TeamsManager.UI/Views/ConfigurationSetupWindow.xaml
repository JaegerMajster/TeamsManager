<Window x:Class="TeamsManager.UI.Views.ConfigurationSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TeamsManager.UI.Converters"
        Title="Konfiguracja TeamsManager" 
        Width="800"
        SizeToContent="Height"
        MinHeight="600"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Style="{StaticResource BaseWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost DialogTheme="Dark">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header z gradientem -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" 
                    Padding="24,16" Effect="{StaticResource ShadowMedium}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <materialDesign:PackIcon Kind="Cog" 
                                           Width="32" Height="32"
                                           VerticalAlignment="Center"
                                           Foreground="White"/>
                    
                    <TextBlock Grid.Column="1" 
                             Text="Konfiguracja TeamsManager"
                             Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                             Foreground="White"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!-- Główna zawartość -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="40,16,40,46">
                <Grid MaxWidth="720">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Ikona konfiguracji -->
                    <Border Grid.Row="0" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24">
                        <Border Background="{DynamicResource AccentBlue}"
                                Width="80" Height="80"
                                CornerRadius="40">
                            <materialDesign:PackIcon Kind="CogOutline" 
                                                   Width="40" Height="40"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                    </Border>

                    <!-- Status walidacji -->
                    <Border Grid.Row="1"
                           Margin="0,0,0,24"
                           Background="{DynamicResource BackgroundMedium}"
                           CornerRadius="8"
                           Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" 
                                                       Width="20" Height="20"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding ValidationStatusColor}"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Status konfiguracji" 
                                         Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Text="{Binding ValidationResult.Summary}" 
                                      Style="{StaticResource MaterialDesignBody1TextBlock}"
                                      Foreground="{Binding ValidationStatusColor}"
                                      Margin="0,0,0,8"/>
                            
                            <!-- Brakujące konfiguracje -->
                            <ItemsControl ItemsSource="{Binding ValidationResult.MissingConfigurations}" 
                                         Visibility="{Binding HasMissingConfigurations, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentRed}"
                                               CornerRadius="4"
                                               Padding="8,4"
                                               Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AlertCircle" 
                                                                       Width="16" Height="16" 
                                                                       Foreground="White" 
                                                                       VerticalAlignment="Center" 
                                                                       Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" 
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                         Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Ostrzeżenia -->
                            <ItemsControl ItemsSource="{Binding ValidationResult.Warnings}" 
                                         Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource WarningOrange}"
                                               CornerRadius="4"
                                               Padding="8,4"
                                               Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Alert" 
                                                                       Width="16" Height="16" 
                                                                       Foreground="White" 
                                                                       VerticalAlignment="Center" 
                                                                       Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" 
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                         Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Konfiguracja Azure AD -->
                    <GroupBox Grid.Row="2" 
                             Header="Konfiguracja Azure AD"
                             Style="{StaticResource MaterialDesignGroupBox}"
                             Margin="0,0,0,24">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Client ID UI -->
                            <TextBox Grid.Row="0"
                                    Margin="0,0,0,16"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding UiClientId, UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="UI Client ID *"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:HintAssist.HelperText="Identyfikator aplikacji UI z Azure AD"
                                    materialDesign:TextFieldAssist.HasClearButton="True"/>
                            
                            <!-- Client ID API -->
                            <TextBox Grid.Row="1"
                                    Margin="0,0,0,16"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding ApiClientId, UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="API Client ID *"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:HintAssist.HelperText="Identyfikator aplikacji API z Azure AD"
                                    materialDesign:TextFieldAssist.HasClearButton="True"/>
                            
                            <!-- Tenant ID -->
                            <TextBox Grid.Row="2"
                                    Margin="0,0,0,16"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="Tenant ID *"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:HintAssist.HelperText="Identyfikator dzierżawy Azure AD"
                                    materialDesign:TextFieldAssist.HasClearButton="True"/>
                            
                            <!-- Client Secret -->
                            <TextBox Grid.Row="3"
                                    Margin="0,0,0,16"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="Client Secret *"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:HintAssist.HelperText="Tajny klucz aplikacji API (dla OBO flow)"
                                    materialDesign:TextFieldAssist.HasClearButton="True"/>
                            
                            <!-- Audience -->
                            <TextBox Grid.Row="4"
                                    Margin="0,0,0,16"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Audience, UpdateSourceTrigger=PropertyChanged}"
                                    materialDesign:HintAssist.Hint="Audience *"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:HintAssist.HelperText="Docelowa grupa odbiorców tokenów"
                                    materialDesign:TextFieldAssist.HasClearButton="True"/>
                        </Grid>
                    </GroupBox>

                    <!-- Konfiguracja aplikacji -->
                    <GroupBox Grid.Row="3" 
                             Header="Konfiguracja aplikacji"
                             Style="{StaticResource MaterialDesignGroupBox}"
                             Margin="0,0,0,24">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Nazwa i wersja -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}"
                                        materialDesign:HintAssist.Hint="Nazwa aplikacji"
                                        materialDesign:HintAssist.IsFloating="True"/>
                                
                                <TextBox Grid.Column="2"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                                        materialDesign:HintAssist.Hint="Wersja"
                                        materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                            
                            <!-- Środowisko -->
                            <ComboBox Grid.Row="1" Margin="0,0,0,16"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     SelectedValue="{Binding Environment}"
                                     materialDesign:HintAssist.Hint="Środowisko"
                                     materialDesign:HintAssist.IsFloating="True">
                                <ComboBoxItem>Development</ComboBoxItem>
                                <ComboBoxItem>Staging</ComboBoxItem>
                                <ComboBoxItem>Production</ComboBoxItem>
                            </ComboBox>
                            
                            <!-- API Base URL i Timeout -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                        materialDesign:HintAssist.Hint="API Base URL"
                                        materialDesign:HintAssist.IsFloating="True"/>
                                
                                <TextBox Grid.Column="2"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding ApiTimeout, UpdateSourceTrigger=PropertyChanged}"
                                        materialDesign:HintAssist.Hint="Timeout (s)"
                                        materialDesign:HintAssist.IsFloating="True"/>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
            
            <!-- Footer z przyciskami -->
            <Border Grid.Row="2" 
                   Background="{DynamicResource BackgroundMedium}"
                   BorderBrush="{DynamicResource BorderDark}"
                   BorderThickness="0,1,0,0">
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Status info -->
                    <TextBlock Grid.Column="0"
                             Text="{Binding StatusMessage}"
                             Style="{StaticResource MaterialDesignBody2TextBlock}"
                             Foreground="{DynamicResource TextSecondary}"
                             VerticalAlignment="Center"/>
                    
                    <!-- Przyciski akcji -->
                    <Button Grid.Column="1"
                           Style="{StaticResource SecondaryActionButton}"
                           Content="WALIDUJ"
                           Command="{Binding ValidateCommand}"
                           Margin="0,0,8,0"/>
                    
                    <Button Grid.Column="2"
                           Style="{StaticResource SecondaryActionButton}"
                           Content="TESTUJ"
                           Command="{Binding TestConnectionCommand}"
                           Margin="0,0,8,0"/>
                    
                    <Button Grid.Column="3"
                           Style="{StaticResource SecondaryActionButton}"
                           Content="ANULUJ"
                           Command="{Binding CancelCommand}"
                           Margin="0,0,8,0"/>
                    
                    <Button Grid.Column="4"
                           Style="{StaticResource PrimaryActionButton}"
                           Command="{Binding SaveCommand}"
                           MinWidth="120">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="ZAPISZ" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="3"
                 Visibility="{Binding IsLoading, 
                            Converter={StaticResource BoolToVisibilityConverter}}"
                 Background="#80000000">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                               IsIndeterminate="True"
                               Width="48"
                               Height="48"/>
                    <TextBlock Text="Zapisywanie konfiguracji..."
                             Style="{StaticResource MaterialDesignBody1TextBlock}"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window> 
<Window x:Class="TeamsManager.UI.Views.ConfigurationSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TeamsManager.UI.Converters"
        Title="Konfiguracja TeamsManager" 
        Width="1000"
        SizeToContent="Height"
        MinHeight="600"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDark}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Style="{StaticResource BaseWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost DialogTheme="Dark">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header z gradientem -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" 
                    Padding="24,16" Effect="{StaticResource ShadowMedium}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <materialDesign:PackIcon Kind="Cog" 
                                           Width="32" Height="32"
                                           VerticalAlignment="Center"
                                           Foreground="White"/>
                    
                    <TextBlock Grid.Column="1" 
                             Text="Konfiguracja TeamsManager"
                             Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                             Foreground="White"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!-- Główna zawartość -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Visible" 
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="40,16,20,46">
                <StackPanel MaxWidth="920">
                    
                    <!-- Ikona konfiguracji -->
                    <Border HorizontalAlignment="Center" Margin="0,24,0,24">
                        <Border Background="{DynamicResource AccentBlue}"
                                Width="80" Height="80"
                                CornerRadius="40">
                            <materialDesign:PackIcon Kind="CogOutline" 
                                                   Width="40" Height="40"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                    </Border>

                    <!-- Status walidacji -->
                    <materialDesign:Card Margin="30,0,30,24" 
                                        materialDesign:ElevationAssist.Elevation="Dp2"
                                        Background="#FF2D2D30">
                        <Expander IsExpanded="False"
                                 Style="{StaticResource MaterialDesignExpander}"
                                 Background="Transparent">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" 
                                                           Width="24" Height="24"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           Margin="0,0,12,0"/>
                                    <TextBlock Text="Status konfiguracji" 
                                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="24,0,24,20">
                                <TextBlock Text="{Binding ValidationResult.Summary}" 
                                          Style="{StaticResource MaterialDesignBody1TextBlock}"
                                          FontWeight="Medium"
                                          Foreground="{Binding ValidationStatusColor}"
                                          Margin="0,0,0,12"/>
                                
                                <!-- Brakujące konfiguracje -->
                                <ItemsControl ItemsSource="{Binding ValidationResult.MissingConfigurations}" 
                                             Visibility="{Binding HasMissingConfigurations, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AccentRed}"
                                                   CornerRadius="4"
                                                   Padding="8,4"
                                                   Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AlertCircle" 
                                                                           Width="16" Height="16" 
                                                                           Foreground="White" 
                                                                           VerticalAlignment="Center" 
                                                                           Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" 
                                                             Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                             Foreground="White"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Ostrzeżenia -->
                                <ItemsControl ItemsSource="{Binding ValidationResult.Warnings}" 
                                             Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WarningOrange}"
                                                   CornerRadius="4"
                                                   Padding="8,4"
                                                   Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Alert" 
                                                                           Width="16" Height="16" 
                                                                           Foreground="White" 
                                                                           VerticalAlignment="Center" 
                                                                           Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" 
                                                             Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                             Foreground="White"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>

                    <!-- Instrukcje konfiguracji Entra ID -->
                    <materialDesign:Card Margin="30,0,30,24" 
                                        materialDesign:ElevationAssist.Elevation="Dp2"
                                        Background="#FF2D2D30">
                        <Expander IsExpanded="False"
                                 Style="{StaticResource MaterialDesignExpander}"
                                 Background="Transparent">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BookOpenPageVariant" 
                                                           Width="24" Height="24"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           Margin="0,0,12,0"/>
                                    <TextBlock Text="Instrukcje konfiguracji Entra ID" 
                                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="24,0,24,20">
                                <TextBlock Text="Przewodnik krok po kroku konfiguracji aplikacji w Microsoft Entra ID"
                                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                                          Foreground="{DynamicResource TextSecondary}"
                                          Margin="0,0,0,20"/>

                                <!-- Sekcja 1: Rejestracja aplikacji UI -->
                                <Border Background="#FF1E1E1E" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="1. Rejestracja aplikacji UI (Desktop)"
                                                 Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                 Foreground="{DynamicResource AccentBlue}"
                                                 Margin="0,0,0,12"/>
                                        
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                                 Style="{StaticResource MaterialDesignBody2TextBlock}">
                                            <Run FontWeight="Bold">Krok 1.1:</Run> Przejdź do <Run FontWeight="Bold">portal.azure.com</Run><LineBreak/>
                                            <Run FontWeight="Bold">Krok 1.2:</Run> W menu po lewej wybierz <Run FontWeight="Bold">Microsoft Entra ID</Run><LineBreak/>
                                            <Run FontWeight="Bold">Krok 1.3:</Run> Kliknij <Run FontWeight="Bold">"App registrations"</Run> w sekcji "Manage"<LineBreak/>
                                            <Run FontWeight="Bold">Krok 1.4:</Run> Kliknij <Run FontWeight="Bold">"+ New registration"</Run> na górze<LineBreak/>
                                            <Run FontWeight="Bold">Krok 1.5:</Run> Wypełnij formularz:<LineBreak/>
                                            &#160;&#160;• Name: <Run FontWeight="Bold">"TeamsManager UI"</Run><LineBreak/>
                                            &#160;&#160;• Supported account types: <Run FontWeight="Bold">"Accounts in this organizational directory only"</Run><LineBreak/>
                                            &#160;&#160;• Redirect URI: wybierz <Run FontWeight="Bold">"Public client/native (mobile &amp; desktop)"</Run><LineBreak/>
                                            &#160;&#160;• W polu URI wpisz: <Run FontWeight="Bold">"http://localhost"</Run><LineBreak/>
                                            <Run FontWeight="Bold">Krok 1.6:</Run> Kliknij <Run FontWeight="Bold">"Register"</Run>
                                        </TextBlock>
                                        
                                        <Border Background="#FF2D4A2D" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="✅ SKOPIUJ TERAZ:" FontWeight="Bold" Foreground="#FF90EE90" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#FF90EE90"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    Na stronie przeglądu nowo utworzonej aplikacji znajdź sekcję <Run FontWeight="Bold">"Essentials"</Run>.<LineBreak/>
                                                    Skopiuj wartość <Run FontWeight="Bold">"Application (client) ID"</Run> i wklej ją do pola <Run FontWeight="Bold">"Client ID dla UI"</Run> poniżej.
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Sekcja 2: Rejestracja aplikacji API -->
                                <Border Background="#FF1E1E1E" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="2. Rejestracja aplikacji API (Web)"
                                                 Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                 Foreground="{DynamicResource AccentBlue}"
                                                 Margin="0,0,0,12"/>
                                        
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                                 Style="{StaticResource MaterialDesignBody2TextBlock}">
                                            <Run FontWeight="Bold">Krok 2.1:</Run> Wróć do listy <Run FontWeight="Bold">"App registrations"</Run><LineBreak/>
                                            <Run FontWeight="Bold">Krok 2.2:</Run> Kliknij ponownie <Run FontWeight="Bold">"+ New registration"</Run><LineBreak/>
                                            <Run FontWeight="Bold">Krok 2.3:</Run> Wypełnij formularz:<LineBreak/>
                                            &#160;&#160;• Name: <Run FontWeight="Bold">"TeamsManager API"</Run><LineBreak/>
                                            &#160;&#160;• Supported account types: <Run FontWeight="Bold">"Accounts in this organizational directory only"</Run><LineBreak/>
                                            &#160;&#160;• Redirect URI: <Run FontWeight="Bold">pozostaw puste</Run><LineBreak/>
                                            <Run FontWeight="Bold">Krok 2.4:</Run> Kliknij <Run FontWeight="Bold">"Register"</Run>
                                        </TextBlock>
                                        
                                        <Border Background="#FF2D4A2D" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="✅ SKOPIUJ TERAZ:" FontWeight="Bold" Foreground="#FF90EE90" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#FF90EE90"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    Na stronie przeglądu nowo utworzonej aplikacji API znajdź sekcję <Run FontWeight="Bold">"Essentials"</Run>.<LineBreak/>
                                                    Skopiuj wartość <Run FontWeight="Bold">"Application (client) ID"</Run> i wklej ją do pola <Run FontWeight="Bold">"Client ID dla API"</Run> poniżej.
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,12"
                                                 Style="{StaticResource MaterialDesignBody2TextBlock}">
                                            <Run FontWeight="Bold">Krok 2.5:</Run> Teraz utwórz Client Secret:<LineBreak/>
                                            &#160;&#160;• W menu po lewej kliknij <Run FontWeight="Bold">"Certificates &amp; secrets"</Run><LineBreak/>
                                            &#160;&#160;• W sekcji "Client secrets" kliknij <Run FontWeight="Bold">"+ New client secret"</Run><LineBreak/>
                                            &#160;&#160;• Description: <Run FontWeight="Bold">"TeamsManager Secret"</Run><LineBreak/>
                                            &#160;&#160;• Expires: <Run FontWeight="Bold">"24 months"</Run><LineBreak/>
                                            &#160;&#160;• Kliknij <Run FontWeight="Bold">"Add"</Run>
                                        </TextBlock>
                                        
                                        <Border Background="#FF4A2D2D" CornerRadius="4" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="⚠️ WAŻNE - SKOPIUJ NATYCHMIAST:" FontWeight="Bold" Foreground="#FFFF6B6B" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#FFFF6B6B"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    Po utworzeniu sekretu <Run FontWeight="Bold">NATYCHMIAST</Run> skopiuj wartość z kolumny <Run FontWeight="Bold">"Value"</Run> (nie "Secret ID"!).<LineBreak/>
                                                    Wklej ją do pola <Run FontWeight="Bold">"Client Secret dla API"</Run> poniżej.<LineBreak/>
                                                    <Run FontWeight="Bold">UWAGA:</Run> Ta wartość będzie widoczna tylko raz!
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Sekcja 3: Uprawnienia -->
                                <Border Background="#FF1E1E1E" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="3. Konfiguracja uprawnień"
                                                 Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                 Foreground="{DynamicResource AccentBlue}"
                                                 Margin="0,0,0,12"/>
                                        
                                        <!-- Uprawnienia dla aplikacji UI -->
                                        <Border Background="#FF2A2A3A" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="🔹 Dla aplikacji UI (TeamsManager UI):" FontWeight="Bold" Foreground="#FF87CEEB" Margin="0,0,0,8"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    <Run FontWeight="Bold">Krok 3.1:</Run> Przejdź do aplikacji <Run FontWeight="Bold">"TeamsManager UI"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.2:</Run> W menu po lewej kliknij <Run FontWeight="Bold">"API permissions"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.3:</Run> Kliknij <Run FontWeight="Bold">"+ Add a permission"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.4:</Run> Wybierz <Run FontWeight="Bold">"Microsoft Graph"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.5:</Run> Wybierz <Run FontWeight="Bold">"Delegated permissions"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.6:</Run> Znajdź i zaznacz te uprawnienia:<LineBreak/>
                                                    &#160;&#160;• <Run FontWeight="Bold">User.Read</Run> (w sekcji "User")<LineBreak/>
                                                    &#160;&#160;• <Run FontWeight="Bold">Team.ReadWrite.All</Run> (w sekcji "Team")<LineBreak/>
                                                    &#160;&#160;• <Run FontWeight="Bold">Group.ReadWrite.All</Run> (w sekcji "Group")<LineBreak/>
                                                    &#160;&#160;• <Run FontWeight="Bold">Directory.Read.All</Run> (w sekcji "Directory")<LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.7:</Run> Kliknij <Run FontWeight="Bold">"Add permissions"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.8:</Run> Kliknij <Run FontWeight="Bold">"Grant admin consent for [nazwa organizacji]"</Run>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Uprawnienia dla aplikacji API -->
                                        <Border Background="#FF3A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="🔹 Dla aplikacji API (TeamsManager API):" FontWeight="Bold" Foreground="#FFFF9A56" Margin="0,0,0,8"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    <Run FontWeight="Bold">Krok 3.9:</Run> Przejdź do aplikacji <Run FontWeight="Bold">"TeamsManager API"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.10:</Run> W menu po lewej kliknij <Run FontWeight="Bold">"API permissions"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.11:</Run> Kliknij <Run FontWeight="Bold">"+ Add a permission"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.12:</Run> Wybierz <Run FontWeight="Bold">"Microsoft Graph"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.13:</Run> Wybierz <Run FontWeight="Bold">"Application permissions"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.14:</Run> Znajdź i zaznacz te uprawnienia:<LineBreak/>
                                                    &#160;&#160;• <Run FontWeight="Bold">Team.ReadWrite.All</Run> (w sekcji "Team")<LineBreak/>
                                                    &#160;&#160;• <Run FontWeight="Bold">Group.ReadWrite.All</Run> (w sekcji "Group")<LineBreak/>
                                                    &#160;&#160;• <Run FontWeight="Bold">User.Read.All</Run> (w sekcji "User")<LineBreak/>
                                                    &#160;&#160;• <Run FontWeight="Bold">Directory.Read.All</Run> (w sekcji "Directory")<LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.15:</Run> Kliknij <Run FontWeight="Bold">"Add permissions"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 3.16:</Run> Kliknij <Run FontWeight="Bold">"Grant admin consent for [nazwa organizacji]"</Run>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        
                                        <Border Background="#FF4A2D2D" CornerRadius="4" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="⚠️ WYMAGANE UPRAWNIENIA ADMINISTRATORA" FontWeight="Bold" Foreground="#FFFF6B6B" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#FFFF6B6B"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    Te uprawnienia wymagają zatwierdzenia przez administratora organizacji.<LineBreak/>
                                                    Bez nich aplikacja nie będzie mogła zarządzać zespołami Microsoft Teams.
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Sekcja 4: Finalizacja -->
                                <Border Background="#FF1E1E1E" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="4. Finalizacja konfiguracji"
                                                 Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                 Foreground="{DynamicResource AccentBlue}"
                                                 Margin="0,0,0,12"/>
                                        
                                        <!-- Tenant ID -->
                                        <Border Background="#FF2D4A2D" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="🔍 Znajdowanie Tenant ID:" FontWeight="Bold" Foreground="#FF90EE90" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#FF90EE90"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    <Run FontWeight="Bold">Krok 4.1:</Run> Przejdź do głównej strony <Run FontWeight="Bold">Microsoft Entra ID</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 4.2:</Run> W sekcji "Overview" znajdź <Run FontWeight="Bold">"Basic information"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 4.3:</Run> Skopiuj wartość <Run FontWeight="Bold">"Tenant ID"</Run> i wklej do pola <Run FontWeight="Bold">"Tenant ID"</Run> poniżej
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Walidacja -->
                                        <Border Background="#FF3A3A2A" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="✅ Sprawdzenie konfiguracji:" FontWeight="Bold" Foreground="#FFFFEB3B" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#FFFFEB3B"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    <Run FontWeight="Bold">Krok 4.4:</Run> Sprawdź czy wszystkie pola poniżej są wypełnione:<LineBreak/>
                                                    &#160;&#160;• Tenant ID<LineBreak/>
                                                    &#160;&#160;• Client ID dla UI<LineBreak/>
                                                    &#160;&#160;• Client ID dla API<LineBreak/>
                                                    &#160;&#160;• Client Secret dla API<LineBreak/>
                                                    <Run FontWeight="Bold">Krok 4.5:</Run> Kliknij przycisk <Run FontWeight="Bold">"TESTUJ POŁĄCZENIE"</Run><LineBreak/>
                                                    <Run FontWeight="Bold">Krok 4.6:</Run> Jeśli test przejdzie pomyślnie, kliknij <Run FontWeight="Bold">"ZAPISZ KONFIGURACJĘ"</Run>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Uwagi techniczne -->
                                        <Border Background="#FF2A2A3A" CornerRadius="4" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="🔐 Informacje techniczne:" FontWeight="Bold" Foreground="#FF87CEEB" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#FF87CEEB"
                                                         Style="{StaticResource MaterialDesignBody2TextBlock}">
                                                    • Aplikacja używa <Run FontWeight="Bold">Windows Hello/WAM</Run> do bezpiecznego uwierzytelniania<LineBreak/>
                                                    • Wrażliwe dane są szyfrowane przy użyciu <Run FontWeight="Bold">DPAPI + AES-256-GCM</Run><LineBreak/>
                                                    • Konfiguracja jest zapisywana w <Run FontWeight="Bold">%APPDATA%\TeamsManager\</Run><LineBreak/>
                                                    • Po pomyślnej konfiguracji będziesz mógł zarządzać zespołami Teams
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>

                    <!-- Azure AD Configuration -->
                    <materialDesign:Card Margin="30,0,30,24" 
                                        materialDesign:ElevationAssist.Elevation="Dp2"
                                        Background="#FF2D2D30">
                        <Expander IsExpanded="False"
                                 Style="{StaticResource MaterialDesignExpander}"
                                 Background="Transparent">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftAzure" 
                                                           Width="24" Height="24"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           Margin="0,0,12,0"/>
                                    <TextBlock Text="Microsoft Entra ID" 
                                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="24,0,24,20">
                                <TextBlock Text="Ustawienia połączenia z Microsoft Entra ID i rejestracji aplikacji"
                                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                                          Foreground="{DynamicResource TextSecondary}"
                                          Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Tenant ID *"
                                            materialDesign:HintAssist.IsFloating="True"
                                            materialDesign:HintAssist.HelperText="GUID identyfikator dzierżawy Microsoft Entra ID"
                                            Margin="0,0,0,20"/>

                                    <TextBox Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding UiClientId, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Client ID dla UI *"
                                            materialDesign:HintAssist.IsFloating="True"
                                            materialDesign:HintAssist.HelperText="GUID aplikacji klienckiej UI"
                                            Margin="0,0,0,20"/>

                                    <TextBox Grid.Row="1" Grid.Column="0"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding ApiClientId, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Client ID dla API *"
                                            materialDesign:HintAssist.IsFloating="True"
                                            materialDesign:HintAssist.HelperText="GUID aplikacji API"
                                            Margin="0,0,0,20"/>

                                    <PasswordBox Grid.Row="1" Grid.Column="2"
                                               Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                               materialDesign:PasswordBoxAssist.Password="{Binding ApiClientSecret, UpdateSourceTrigger=PropertyChanged}"
                                               materialDesign:HintAssist.Hint="Client Secret dla API *"
                                               materialDesign:HintAssist.IsFloating="True"
                                               materialDesign:HintAssist.HelperText="Tajny klucz aplikacji API"
                                               Margin="0,0,0,20"/>

                                    <TextBox Grid.Row="2" Grid.ColumnSpan="3"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding InstanceUrl, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Instance URL"
                                            materialDesign:HintAssist.IsFloating="True"
                                            materialDesign:HintAssist.HelperText="URL instancji Microsoft Entra ID (domyślnie: https://login.microsoftonline.com/)"
                                            Margin="0,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>

                    <!-- Application Configuration -->
                    <materialDesign:Card Margin="30,0,30,24" 
                                        materialDesign:ElevationAssist.Elevation="Dp2"
                                        Background="#FF2D2D30">
                        <Expander IsExpanded="False"
                                 Style="{StaticResource MaterialDesignExpander}"
                                 Background="Transparent">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Application" 
                                                           Width="24" Height="24"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           Margin="0,0,12,0"/>
                                    <TextBlock Text="Konfiguracja aplikacji" 
                                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="24,0,24,20">
                                <TextBlock Text="Podstawowe ustawienia aplikacji i połączenia z API"
                                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                                          Foreground="{DynamicResource TextSecondary}"
                                          Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Nazwa aplikacji"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Margin="0,0,0,20"/>

                                    <TextBox Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding ApplicationVersion, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Wersja aplikacji"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Margin="0,0,0,20"/>

                                    <TextBox Grid.Row="1" Grid.Column="0"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="URL API *"
                                            materialDesign:HintAssist.IsFloating="True"
                                            materialDesign:HintAssist.HelperText="np. https://localhost:7037/"
                                            Margin="0,0,0,20"/>

                                    <TextBox Grid.Row="1" Grid.Column="2"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding ApiTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Timeout API (sekundy)"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Margin="0,0,0,20"/>

                                    <CheckBox Grid.Row="2" Grid.ColumnSpan="3"
                                             Style="{StaticResource MaterialDesignCheckBox}"
                                             IsChecked="{Binding EnableAuditLogging}"
                                             Content="Włącz audit logging"
                                             ToolTip="Włącza rejestrowanie działań użytkowników"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>

                    <!-- Database Configuration -->
                    <materialDesign:Card Margin="30,0,30,24" 
                                        materialDesign:ElevationAssist.Elevation="Dp2"
                                        Background="#FF2D2D30">
                        <Expander IsExpanded="False"
                                 Style="{StaticResource MaterialDesignExpander}"
                                 Background="Transparent">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Database" 
                                                           Width="24" Height="24"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           Margin="0,0,12,0"/>
                                    <TextBlock Text="Baza danych" 
                                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="24,0,24,20">
                                <TextBlock Text="Ustawienia połączenia z bazą danych SQLite"
                                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                                          Foreground="{DynamicResource TextSecondary}"
                                          Margin="0,0,0,20"/>

                                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         SelectedItem="{Binding DatabaseProvider}"
                                         ItemsSource="{Binding AvailableProviders}"
                                         materialDesign:HintAssist.Hint="Provider bazy danych"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Margin="0,0,0,20"/>

                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding DatabaseConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                        materialDesign:HintAssist.Hint="Connection String *"
                                        materialDesign:HintAssist.IsFloating="True"
                                        materialDesign:HintAssist.HelperText="Ścieżka do pliku bazy danych SQLite"
                                        Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox Grid.Column="0"
                                             Style="{StaticResource MaterialDesignCheckBox}"
                                             IsChecked="{Binding EnableAutoMigrations}"
                                             Content="Automatyczne migracje"
                                             ToolTip="Automatyczne stosowanie migracji bazy danych przy starcie"/>

                                    <TextBox Grid.Column="2"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding CommandTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Timeout poleceń (sekundy)"
                                            materialDesign:HintAssist.IsFloating="True"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>

                    <!-- Walidacja konfiguracji -->
                    <materialDesign:Card Margin="30,0,30,24" 
                                        materialDesign:ElevationAssist.Elevation="Dp2"
                                        Background="#FF2D2D30">
                        <Expander IsExpanded="False"
                                 Style="{StaticResource MaterialDesignExpander}"
                                 Background="Transparent">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" 
                                                           Width="24" Height="24"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           Margin="0,0,12,0"/>
                                    <TextBlock Text="Walidacja konfiguracji" 
                                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="24,0,24,20">
                                <TextBlock Text="Sprawdzenie kompletności i poprawności wszystkich ustawień"
                                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                                          Foreground="{DynamicResource TextSecondary}"
                                          Margin="0,0,0,20"/>

                                <!-- Status ogólny -->
                                <Border Background="{Binding ValidationStatusColor}"
                                       CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Width="20" Height="20"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="CheckCircle"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ValidationResult.IsValid}" Value="False">
                                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="{Binding ValidationResult.Summary}" 
                                                     Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                     FontWeight="Bold"
                                                     Foreground="White"/>
                                        </StackPanel>
                                        
                                        <TextBlock Text="Kliknij 'WALIDUJ KONFIGURACJĘ' aby sprawdzić aktualny status wszystkich ustawień"
                                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                 Foreground="White"
                                                 Opacity="0.9"/>
                                    </StackPanel>
                                </Border>

                                <!-- Brakujące konfiguracje -->
                                <Border Background="#FF4A2D2D" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                       Visibility="{Binding HasMissingConfigurations, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="AlertCircle" 
                                                                   Width="18" Height="18"
                                                                   Foreground="#FFFF6B6B"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="Brakujące konfiguracje:" 
                                                     FontWeight="Bold" 
                                                     Foreground="#FFFF6B6B"/>
                                        </StackPanel>
                                        
                                        <ItemsControl ItemsSource="{Binding ValidationResult.MissingConfigurations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <materialDesign:PackIcon Kind="Circle" 
                                                                               Width="6" Height="6" 
                                                                               Foreground="#FFFF6B6B" 
                                                                               VerticalAlignment="Center" 
                                                                               Margin="16,0,8,0"/>
                                                        <TextBlock Text="{Binding}" 
                                                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                                 Foreground="#FFFF6B6B"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Nieprawidłowe konfiguracje -->
                                <Border Background="#FF4A2D2D" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                       Visibility="{Binding ValidationResult.InvalidConfigurations.Count, Converter={StaticResource IntToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="CloseCircle" 
                                                                   Width="18" Height="18"
                                                                   Foreground="#FFFF6B6B"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="Nieprawidłowe konfiguracje:" 
                                                     FontWeight="Bold" 
                                                     Foreground="#FFFF6B6B"/>
                                        </StackPanel>
                                        
                                        <ItemsControl ItemsSource="{Binding ValidationResult.InvalidConfigurations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <materialDesign:PackIcon Kind="Circle" 
                                                                               Width="6" Height="6" 
                                                                               Foreground="#FFFF6B6B" 
                                                                               VerticalAlignment="Center" 
                                                                               Margin="16,0,8,0"/>
                                                        <TextBlock Text="{Binding}" 
                                                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                                 Foreground="#FFFF6B6B"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Ostrzeżenia -->
                                <Border Background="#FF3A3A2A" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                       Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="Alert" 
                                                                   Width="18" Height="18"
                                                                   Foreground="#FFFFEB3B"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="Ostrzeżenia:" 
                                                     FontWeight="Bold" 
                                                     Foreground="#FFFFEB3B"/>
                                        </StackPanel>
                                        
                                        <ItemsControl ItemsSource="{Binding ValidationResult.Warnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <materialDesign:PackIcon Kind="Circle" 
                                                                               Width="6" Height="6" 
                                                                               Foreground="#FFFFEB3B" 
                                                                               VerticalAlignment="Center" 
                                                                               Margin="16,0,8,0"/>
                                                        <TextBlock Text="{Binding}" 
                                                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                                 Foreground="#FFFFEB3B"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Instrukcje naprawy -->
                                <Border Background="#FF2A2A3A" CornerRadius="6" Padding="12"
                                       Visibility="{Binding ValidationResult.IsValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="InformationOutline" 
                                                                   Width="18" Height="18"
                                                                   Foreground="#FF87CEEB"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="Jak naprawić:" 
                                                     FontWeight="Bold" 
                                                     Foreground="#FF87CEEB"/>
                                        </StackPanel>
                                        
                                        <TextBlock TextWrapping="Wrap" Foreground="#FF87CEEB"
                                                 Style="{StaticResource MaterialDesignBody2TextBlock}">
                                            1. Sprawdź sekcję <Run FontWeight="Bold">"Instrukcje konfiguracji Entra ID"</Run> powyżej<LineBreak/>
                                            2. Wypełnij wszystkie wymagane pola w sekcji <Run FontWeight="Bold">"Microsoft Entra ID"</Run><LineBreak/>
                                            3. Kliknij <Run FontWeight="Bold">"TESTUJ POŁĄCZENIE"</Run> aby sprawdzić poprawność danych<LineBreak/>
                                            4. Po pomyślnym teście kliknij <Run FontWeight="Bold">"ZAPISZ KONFIGURACJĘ"</Run>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>

                    <!-- Advanced Settings -->
                    <materialDesign:Card Margin="30,0,30,24"
                                        materialDesign:ElevationAssist.Elevation="Dp2"
                                        Background="#FF2D2D30">
                        <Expander Style="{StaticResource MaterialDesignExpander}"
                                 Background="Transparent"
                                 IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TuneVertical" 
                                                           Width="24" Height="24"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           Margin="0,0,12,0"/>
                                    <TextBlock Text="Ustawienia zaawansowane" 
                                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="24,0,24,20">
                                <TextBlock Text="Limity i funkcje eksperymentalne"
                                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                                          Foreground="{DynamicResource TextSecondary}"
                                          Margin="0,0,0,20"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding MaxBulkOperations, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Max operacji bulk"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Margin="0,0,0,20"/>

                                    <TextBox Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Text="{Binding MaxConcurrentRequests, UpdateSourceTrigger=PropertyChanged}"
                                            materialDesign:HintAssist.Hint="Max równoczesnych żądań"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Margin="0,0,0,20"/>

                                    <CheckBox Grid.Row="1" Grid.ColumnSpan="3"
                                             Style="{StaticResource MaterialDesignCheckBox}"
                                             IsChecked="{Binding EnableBetaFeatures}"
                                             Content="Włącz funkcje beta"
                                             ToolTip="Włącza eksperymentalne funkcje (może być niestabilne)"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer z przyciskami -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,1,0,0"
                    Effect="{StaticResource ShadowLight}">
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Status info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Error message -->
                        <materialDesign:PackIcon Kind="AlertCircle" 
                                               Width="16" Height="16"
                                               Foreground="{StaticResource AccentRed}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        
                        <TextBlock Text="{Binding ErrorMessage}"
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                 Foreground="{StaticResource AccentRed}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        
                        <!-- Status message when no error -->
                        <TextBlock Text="{Binding StatusMessage}"
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    </StackPanel>
                    
                    <!-- Przyciski akcji -->
                    <Button Grid.Column="1"
                           Style="{StaticResource SecondaryActionButton}"
                           Command="{Binding TestConnectionCommand}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TestTube" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="TESTUJ POŁĄCZENIE" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Grid.Column="2"
                           Style="{StaticResource SecondaryActionButton}"
                           Command="{Binding ValidateCommand}"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="WALIDUJ KONFIGURACJĘ" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Grid.Column="3"
                           Style="{StaticResource SecondaryActionButton}"
                           Content="ANULUJ"
                           Command="{Binding CancelCommand}"
                           Margin="0,0,8,0"/>
                    
                    <!-- Przycisk Zapisz -->
                    <Button Grid.Column="4"
                           Style="{StaticResource PrimaryActionButton}"
                           Command="{Binding SaveConfigurationCommand}"
                           MinWidth="140">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                            <TextBlock Text="ZAPISZ KONFIGURACJĘ" 
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="3"
                 Visibility="{Binding IsLoading, 
                            Converter={StaticResource BoolToVisibilityConverter}}"
                 Background="#80000000">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                               IsIndeterminate="True"
                               Width="48"
                               Height="48"/>
                    <TextBlock Text="Zapisywanie konfiguracji..."
                             Style="{StaticResource MaterialDesignBody1TextBlock}"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window> 
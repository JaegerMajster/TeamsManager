<Window x:Class="TeamsManager.UI.Views.Diagnostics.GraphApiDiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Diagnostyka Graph API - TeamsManager" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Style="{StaticResource MaterialDesignWindow}">

    <Window.Resources>
        <converters:StringContainsConverter x:Key="StringContainsConverter" xmlns:converters="clr-namespace:TeamsManager.UI.Converters"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:converters="clr-namespace:TeamsManager.UI.Converters"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        </Style>
        
        <Style TargetType="TextBlock" x:Key="TestResult">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="20,2,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="Stethoscope" 
                                       Width="24" Height="24" 
                                       VerticalAlignment="Center"
                                       Foreground="White" Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="1" Text="Diagnostyka Microsoft Graph API" 
                          FontSize="18" FontWeight="Bold" 
                          Foreground="White" VerticalAlignment="Center"/>

                <Button Grid.Column="2" x:Name="RefreshButton" 
                       Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                       ToolTip="Odśwież diagnostykę"
                       Click="RefreshButton_Click">
                    <materialDesign:PackIcon Kind="Refresh" />
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Overall Status -->
                <materialDesign:Card Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon x:Name="StatusIcon" Grid.Column="0" 
                                               Width="32" Height="32" 
                                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="OverallStatusText" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TimestampText" FontSize="12" Opacity="0.7"/>
                        </StackPanel>

                        <materialDesign:PackIcon Grid.Column="2" Kind="Information" 
                                               Width="20" Height="20" 
                                               VerticalAlignment="Center" Opacity="0.5"/>
                    </Grid>
                </materialDesign:Card>

                <!-- Test Results -->
                <materialDesign:Card Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Wyniki testów diagnostycznych" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="TestResultsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,5,0,5" Padding="10" 
                                           BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                           BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Status Icon -->
                                            <materialDesign:PackIcon Grid.Column="0" Grid.Row="0" 
                                                                   Width="20" Height="20" 
                                                                   VerticalAlignment="Center" 
                                                                   Margin="0,0,10,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Healthy">
                                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                                <Setter Property="Foreground" Value="Green"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                                <Setter Property="Foreground" Value="Orange"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Critical">
                                                                <Setter Property="Kind" Value="CloseCircle"/>
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>

                                            <!-- Test Name -->
                                            <TextBlock Grid.Column="1" Grid.Row="0" 
                                                     Text="{Binding TestName}" 
                                                     FontWeight="Bold" VerticalAlignment="Center"/>

                                            <!-- Status Text -->
                                            <TextBlock Grid.Column="2" Grid.Row="0" 
                                                     Text="{Binding Status}" 
                                                     VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Healthy">
                                                                <Setter Property="Foreground" Value="Green"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="Orange"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Critical">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Details -->
                                            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" 
                                                     Text="{Binding Details}" 
                                                     FontSize="11" Opacity="0.7" 
                                                     TextWrapping="Wrap" Margin="0,5,0,0"
                                                     Visibility="{Binding Details, Converter={StaticResource NullToVisibilityConverter}}"/>

                                            <!-- Error Message -->
                                            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" 
                                                     Text="{Binding ErrorMessage}" 
                                                     FontSize="11" Foreground="Red" 
                                                     TextWrapping="Wrap" Margin="0,5,0,0"
                                                     Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Recommendations -->
                <materialDesign:Card Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Zalecenia naprawcze" Style="{StaticResource SectionHeader}"/>
                        <ItemsControl x:Name="RecommendationsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <materialDesign:PackIcon Kind="ChevronRight" 
                                                               Width="16" Height="16" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,5,0" 
                                                               Opacity="0.6"/>
                                        <TextBlock Text="{Binding}" 
                                                 TextWrapping="Wrap" 
                                                 VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=., Converter={StaticResource StringContainsConverter}, ConverterParameter='KRYTYCZNE'}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=., Converter={StaticResource StringContainsConverter}, ConverterParameter='OSTRZEŻENIE'}" Value="True">
                                                            <Setter Property="Foreground" Value="Orange"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Path=., Converter={StaticResource StringContainsConverter}, ConverterParameter='✅'}" Value="True">
                                                            <Setter Property="Foreground" Value="Green"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Loading Indicator -->
                <materialDesign:Card x:Name="LoadingCard" Padding="20" 
                                   HorizontalAlignment="Center" 
                                   Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                   Width="20" Height="20" 
                                   IsIndeterminate="True" Margin="0,0,10,0"/>
                        <TextBlock Text="Wykonywanie diagnostyki Graph API..." 
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignDivider}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="Sprawdź szczegółowe logi aplikacji w przypadku problemów z Graph API" 
                          VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>

                <Button Grid.Column="1" Content="Zamknij" 
                       Style="{StaticResource MaterialDesignFlatButton}"
                       Click="CloseButton_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window> 
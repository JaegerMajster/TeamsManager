<UserControl x:Class="TeamsManager.UI.Views.Monitoring.Widgets.PerformanceMetricsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <materialDesign:Card>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartLine" 
                                           Width="20" Height="20" 
                                           Foreground="White" 
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="Performance Metrics" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="White"/>
                </StackPanel>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <!-- PowerShell Response Time -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Grid.Column="0" Kind="PowerShell" 
                                               Width="16" Height="16" 
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="PowerShell Operations" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding AverageResponseTime, StringFormat='{}{0:F0}ms'}" 
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ProgressBar Value="{Binding AverageResponseTime}" 
                                 Maximum="1000" 
                                 Height="4" 
                                 Margin="0,0,0,16"/>
                    
                    <!-- Memory Usage (Application) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Grid.Column="0" Kind="Memory" 
                                               Width="16" Height="16" 
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Application Memory" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding MemoryUsage, StringFormat='{}{0:F0} MB'}" 
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ProgressBar Value="{Binding MemoryUsage}" 
                                 Maximum="500" 
                                 Height="4" 
                                 Margin="0,0,0,16"/>
                    
                    <!-- Cache Hit Rate -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Grid.Column="0" Kind="DatabaseSync" 
                                               Width="16" Height="16" 
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Cache Hit Rate" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="85.5%" 
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- TeamsManager Operations Today -->
                    <Separator Margin="0,8"/>
                    
                    <TextBlock Text="Operations Today" 
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,16,0,12"/>
                    
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <materialDesign:PackIcon Kind="MicrosoftTeams" 
                                                   Width="24" Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Teams" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="45" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <materialDesign:PackIcon Kind="AccountGroup" 
                                                   Width="24" Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Users" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="23" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <materialDesign:PackIcon Kind="Forum" 
                                                   Width="24" Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Channels" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="12" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- System Status -->
                    <Separator Margin="0,16,0,8"/>
                    
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PowerShell Connection" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="Green" Margin="0,0,4,0"/>
                                <TextBlock Text="Connected" 
                                           FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Error Rate" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            <TextBlock Text="{Binding ErrorRate, StringFormat='{}{0:F1}%'}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</UserControl> 
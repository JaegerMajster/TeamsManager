<UserControl x:Class="TeamsManager.UI.Views.Monitoring.Widgets.TeamsManagerHealthWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <materialDesign:Card>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HeartPulse" 
                                           Width="20" Height="20" 
                                           Foreground="White" 
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="TeamsManager Health" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="White"/>
                    
                    <!-- Overall Status Indicator -->
                    <Border Background="White" 
                            CornerRadius="12" 
                            Padding="8,4" 
                            Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,4,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverallStatus}" Value="Healthy">
                                                <Setter Property="Fill" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallStatus}" Value="Degraded">
                                                <Setter Property="Fill" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallStatus}" Value="Unhealthy">
                                                <Setter Property="Fill" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding OverallStatus}" 
                                       FontSize="12" 
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    
                    <!-- Components Health -->
                    <TextBlock Text="Komponenty Systemu" 
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,12"/>
                    
                    <ItemsControl ItemsSource="{Binding Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,8"
                                        Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Status Icon -->
                                        <materialDesign:PackIcon Grid.Column="0" 
                                                               Width="16" Height="16" 
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="CheckCircle"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Healthy">
                                                            <Setter Property="Kind" Value="CheckCircle"/>
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Degraded">
                                                            <Setter Property="Kind" Value="AlertCircle"/>
                                                            <Setter Property="Foreground" Value="Orange"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unhealthy">
                                                            <Setter Property="Kind" Value="CloseCircle"/>
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        
                                        <!-- Component Info -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Medium"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" 
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        
                                        <!-- Response Time -->
                                        <StackPanel Grid.Column="2" 
                                                    HorizontalAlignment="Right"
                                                    Margin="8,0">
                                            <TextBlock Text="Response Time" 
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ResponseTime, StringFormat='{}{0}ms'}" 
                                                       FontWeight="Medium"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Last Checked -->
                                        <StackPanel Grid.Column="3" 
                                                    HorizontalAlignment="Right"
                                                    Margin="8,0,0,0">
                                            <TextBlock Text="Last Checked" 
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding LastChecked, StringFormat='{}{0:HH:mm:ss}'}" 
                                                       FontWeight="Medium"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Quick Actions -->
                    <Separator Margin="0,16"/>
                    
                    <TextBlock Text="Szybkie Akcje" 
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,8,0,12"/>
                    
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RunHealthCheckCommand}"
                                Margin="0,0,4,0"
                                ToolTip="Uruchom pełne sprawdzenie zdrowia systemu">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HeartPulse" 
                                                       Width="16" Height="16" 
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Health Check"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RunAutoRepairCommand}"
                                Margin="4,0,0,0"
                                ToolTip="Uruchom automatyczną naprawę problemów">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wrench" 
                                                       Width="16" Height="16" 
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Auto Repair"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    
                    <!-- Module Management Actions -->
                    <UniformGrid Columns="2" Margin="0,4,0,8">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CheckGraphPermissionsCommand}"
                                Margin="0,0,4,0"
                                ToolTip="Sprawdź uprawnienia Graph API">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldCheck" 
                                                       Width="16" Height="16" 
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Sprawdź Uprawnienia"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RefreshGraphTokenCommand}"
                                Margin="4,0,0,0"
                                ToolTip="Odśwież token Graph API">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" 
                                                       Width="16" Height="16" 
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Odśwież Token"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    
                    <!-- Connection Test Action -->
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding TestConnectionCommand}"
                            Margin="0,4,0,8"
                            ToolTip="Wykonaj test połączenia z Microsoft Graph">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TestTube" 
                                                   Width="16" Height="16" 
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="Test Połączenia Graph"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Status Notification -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,8,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Notification Icon -->
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding NotificationIcon}" 
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            
                            <!-- Notification Message -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding LastNotification}" 
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            
                            <!-- Loading Indicator -->
                            <ProgressBar Grid.Column="2"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         Width="20" Height="20"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Graph API Diagnostics -->
                    <Expander Header="Graph API Diagnostics" 
                              Margin="0,8,0,0"
                              IsExpanded="False">
                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Connection Status" 
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                        <TextBlock Text="{Binding GraphDiagnostics.ConnectionStatus}" 
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Token Status" 
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                        <TextBlock Text="{Binding GraphDiagnostics.TokenStatus}" 
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Last Operation" 
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                        <TextBlock Text="{Binding GraphDiagnostics.LastSuccessfulOperation}" 
                                                   FontWeight="Medium"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Error Count" 
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                        <TextBlock Text="{Binding GraphDiagnostics.ErrorCount}" 
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding RefreshDiagnosticsCommand}"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" 
                                                               Width="16" Height="16" 
                                                               Margin="0,0,4,0"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Expander>
                    
                    <!-- Last Updated -->
                    <TextBlock Text="{Binding LastUpdated, StringFormat='Ostatnia aktualizacja: {0:HH:mm:ss}'}"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</UserControl> 
<UserControl x:Class="TeamsManager.UI.Views.Monitoring.Widgets.TeamsManagerMetricsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <materialDesign:Card>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartLine" 
                                           Width="20" Height="20" 
                                           Foreground="White" 
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="TeamsManager Metrics" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="White"/>
                </StackPanel>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    
                    <!-- Response Times -->
                    <TextBlock Text="Response Times" 
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,12"/>
                    

                    
                    <!-- Graph API Response Time -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Grid.Column="0" Kind="MicrosoftOffice" 
                                               Width="16" Height="16" 
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Microsoft Graph API" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding GraphApiResponseTime, StringFormat='{}{0}ms'}" 
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ProgressBar Value="{Binding GraphApiResponseTime}" 
                                 Maximum="1000" 
                                 Height="4" 
                                 Margin="0,0,0,16"/>
                    
                    <!-- Cache Performance -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Grid.Column="0" Kind="DatabaseSync" 
                                               Width="16" Height="16" 
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Cache Hit Rate" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding CacheHitRate, StringFormat='{}{0:F1}%'}" 
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ProgressBar Value="{Binding CacheHitRate}" 
                                 Maximum="100" 
                                 Height="4" 
                                 Margin="0,0,0,16"/>
                    
                    <!-- Operations Today -->
                    <Separator Margin="0,8"/>
                    
                    <TextBlock Text="Operations Today" 
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,16,0,12"/>
                    
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <materialDesign:PackIcon Kind="MicrosoftTeams" 
                                                   Width="24" Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Teams" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TeamsOperationsToday}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <materialDesign:PackIcon Kind="AccountGroup" 
                                                   Width="24" Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Users" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding UsersOperationsToday}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <materialDesign:PackIcon Kind="Forum" 
                                                   Width="24" Height="24" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Channels" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ChannelsOperationsToday}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- System Status -->
                    <Separator Margin="0,16,0,8"/>
                    
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Memory Usage" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            <TextBlock Text="{Binding MemoryUsageMB, StringFormat='{}{0:F0} MB'}" 
                                       FontSize="18" FontWeight="Medium"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Active Connections" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            <TextBlock Text="{Binding ActiveConnections}" 
                                       FontSize="18" FontWeight="Medium"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Error Statistics -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AlertCircle" 
                                                       Width="16" Height="16" 
                                                       Foreground="Red"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Errors (1h)" 
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ErrorsLastHour}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Foreground="Red"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Alert" 
                                                       Width="16" Height="16" 
                                                       Foreground="Orange"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Warnings (1h)" 
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WarningsLastHour}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Foreground="Orange"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Component Health Summary -->
                    <Separator Margin="0,16,0,8"/>
                    
                    <TextBlock Text="Component Health" 
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,8,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircle" 
                                                       Width="16" Height="16" 
                                                       Foreground="Green"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Healthy" 
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ComponentsHealthy}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Foreground="Green"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AlertCircle" 
                                                       Width="16" Height="16" 
                                                       Foreground="Orange"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Degraded" 
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ComponentsDegraded}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Foreground="Orange"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloseCircle" 
                                                       Width="16" Height="16" 
                                                       Foreground="Red"
                                                       Margin="0,0,4,0"/>
                                <TextBlock Text="Unhealthy" 
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ComponentsUnhealthy}" 
                                       FontSize="18" FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Foreground="Red"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Last Updated -->
                    <TextBlock Text="{Binding LastUpdated, StringFormat='Ostatnia aktualizacja: {0:HH:mm:ss}'}"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</UserControl> 
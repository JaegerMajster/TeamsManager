<UserControl x:Class="TeamsManager.UI.Views.Monitoring.MonitoringDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:widgets="clr-namespace:TeamsManager.UI.Views.Monitoring.Widgets"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource BackgroundDark}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Connection Status Converter -->
        <DataTemplate x:Key="ConnectionStatusTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,4,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="Red"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                    <Setter Property="Fill" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
                                    <Setter Property="Fill" Value="Orange"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Reconnecting">
                                    <Setter Property="Fill" Value="Orange"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BackgroundMedium}" 
                Padding="24,16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Ikona -->
                <materialDesign:PackIcon Grid.Column="0" 
                                       Kind="MicrosoftTeams" 
                                       Width="40" Height="40" 
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>

                <!-- Tytuł i podtytuł -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="TeamsManager - Monitoring"
                             Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                             Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LastUpdateTime, StringFormat='Ostatnia aktualizacja: {0:HH:mm:ss}'}"
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                 Margin="0,0,16,0"/>
                        <ContentPresenter Content="{Binding}" 
                                        ContentTemplate="{StaticResource ConnectionStatusTemplate}"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Przyciski akcji -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto-refresh Toggle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Auto-refresh" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <ToggleButton IsChecked="{Binding IsAutoRefreshEnabled}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      ToolTip="Włącz/wyłącz automatyczne odświeżanie co 30 sekund"/>
                    </StackPanel>
                    
                    <Button Style="{StaticResource SecondaryActionButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Odśwież dane monitorowania">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" 
                                                   Width="16" Height="16" 
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="Odśwież"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding RunHealthCheckCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Uruchom pełne sprawdzenie zdrowia TeamsManager">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HeartPulse" 
                                                   Width="16" Height="16" 
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="Diagnostyka"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SuccessButton}"
                            Command="{Binding AutoRepairCommand}"
                            ToolTip="Automatyczna naprawa problemów Graph API">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Wrench" 
                                                   Width="16" Height="16" 
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="Naprawa"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Dashboard Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="500"/>
                    <ColumnDefinition Width="*" MinWidth="500"/>
                </Grid.ColumnDefinitions>
                
                <!-- TeamsManager Health Widget -->
                <materialDesign:Card Grid.Row="0" Grid.Column="0" 
                                   Margin="0,0,8,16"
                                   Padding="0">
                    <widgets:TeamsManagerHealthWidget DataContext="{Binding TeamsManagerHealthViewModel}"/>
                </materialDesign:Card>
                
                <!-- TeamsManager Metrics Widget -->
                <materialDesign:Card Grid.Row="0" Grid.Column="1"
                                   Margin="8,0,0,16"
                                   Padding="0">
                    <widgets:TeamsManagerMetricsWidget DataContext="{Binding TeamsManagerMetricsViewModel}"/>
                </materialDesign:Card>
                
                <!-- Active Operations Widget -->
                <materialDesign:Card Grid.Row="1" Grid.ColumnSpan="2"
                                   Margin="0,0,0,16"
                                   Padding="0">
                    <widgets:ActiveOperationsWidget DataContext="{Binding ActiveOperationsViewModel}"/>
                </materialDesign:Card>
                
                <!-- System Alerts Widget -->
                <materialDesign:Card Grid.Row="2" Grid.ColumnSpan="2"
                                   Padding="0">
                    <widgets:AlertsWidget DataContext="{Binding AlertsViewModel}"/>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>
        
        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <materialDesign:Card Width="200" Height="120" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Width="40" Height="40"
                                 Margin="0,0,0,16"/>
                    <TextBlock Text="Ładowanie monitoringu..."
                               HorizontalAlignment="Center"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
        
        <!-- Connection Status and Notifications -->
        <materialDesign:Snackbar Grid.Row="1" 
                               MessageQueue="{Binding MessageQueue}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               Margin="16"/>
    </Grid>
</UserControl> 
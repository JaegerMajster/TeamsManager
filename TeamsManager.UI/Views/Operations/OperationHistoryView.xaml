<UserControl x:Class="TeamsManager.UI.Views.Operations.OperationHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BackgroundMedium}" 
                Padding="24,16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Ikona -->
                <materialDesign:PackIcon Grid.Column="0" 
                                       Kind="History" 
                                       Width="40" Height="40" 
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>

                <!-- Tytuł i podtytuł -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Historia Operacji"
                             Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                             Margin="0,0,0,8"/>
                    <TextBlock Text="Przeglądaj historię wszystkich operacji wykonanych w systemie"
                             Style="{StaticResource MaterialDesignBody2TextBlock}"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </StackPanel>
                
                <Button Grid.Column="2" 
                        Content="Odśwież" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </Grid>
        </Border>
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Filters -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    Margin="0,0,0,20" Padding="20,15,20,10">
                <materialDesign:Card Padding="0,5,0,5" materialDesign:ElevationAssist.Elevation="Dp0">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox materialDesign:HintAssist.Hint="Kategoria"
                                  MinWidth="180"
                                  ItemsSource="{Binding AvailableEntityTypes}"
                                  SelectedItem="{Binding SelectedEntityType}"
                                  Margin="0,0,20,0"/>
                        
                        <ComboBox materialDesign:HintAssist.Hint="Operacja"
                                  MinWidth="200"
                                  ItemsSource="{Binding AvailableOperations}"
                                  SelectedItem="{Binding SelectedOperationFilter}"
                                  Margin="0,0,20,0"/>
                        
                        <ComboBox materialDesign:HintAssist.Hint="Status"
                                  MinWidth="150"
                                  ItemsSource="{Binding AvailableStatuses}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Margin="0,0,20,0"/>
                        
                        <DatePicker materialDesign:HintAssist.Hint="Data od"
                                   MinWidth="160"
                                   SelectedDate="{Binding StartDate}"
                                   Margin="0,0,20,0"/>
                        
                        <DatePicker materialDesign:HintAssist.Hint="Data do"
                                   MinWidth="160"
                                   SelectedDate="{Binding EndDate}"
                                   Margin="0,0,20,0"/>
                        
                        <Button Content="Wyczyść filtry" 
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </materialDesign:Card>
            </Border>
            
            <!-- Operations List -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredOperations}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      RowHeight="40">
                
                <DataGrid.Resources>
                    <!-- Style dla wyśrodkowania w pionie i poziomie z paddingiem -->
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True"
                                            Padding="5,0">
                                        <ContentPresenter VerticalAlignment="Center" 
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    
                    <!-- Style dla ikony oczka - zmiana koloru na biały gdy wiersz zaznaczony -->
                    <Style x:Key="EyeIconStyle" TargetType="materialDesign:PackIcon">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Typ" Width="60" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Kind="{Binding OperationType, Converter={StaticResource OperationTypeToIconConverter}}" 
                                                       Width="16" Height="16"
                                                       HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="Operacja" 
                                      Binding="{Binding OperationDescription}" 
                                      Width="3*" MinWidth="200">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    SnapsToDevicePixels="True"
                                                    Padding="5,0">
                                                <ContentPresenter VerticalAlignment="Center" 
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Status" 
                                      Binding="{Binding PolishStatus}" 
                                      Width="1*" MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Rozpoczęto" 
                                      Binding="{Binding FormattedStartTime}" 
                                      Width="2*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Ukończono" 
                                      Binding="{Binding FormattedEndTime}" 
                                      Width="2*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Czas trwania" 
                                      Binding="{Binding FormattedDuration}" 
                                      Width="1*" MinWidth="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Wykonał" 
                                      Binding="{Binding DisplayUser}" 
                                      Width="1.5*" MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTemplateColumn Header="Szczegóły" Width="100" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Pokaż szczegóły"
                                        HorizontalAlignment="Center"
                                        Width="35"
                                        Height="35">
                                    <materialDesign:PackIcon Kind="Eye" Width="16" Height="16" Style="{StaticResource EyeIconStyle}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Loading Indicator -->
            <ProgressBar Grid.Row="1"
                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Value="0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            
            <!-- No Data Message -->
            <TextBlock Grid.Row="1"
                       Text="Brak danych do wyświetlenia"
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasNoData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl> 